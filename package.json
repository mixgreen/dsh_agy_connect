{
  "name": "dsh-agy-connect",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Text-only Gemini chat through the official Antigravity CLI for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.3"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.cjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "build": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.11",
    "typescript": "^6.0.3",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "react": "18.3.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3"
  }
}
